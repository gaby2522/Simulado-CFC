rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Coleção Principal de Usuários (users/{userId})
    match /users/{userId} {
      allow read: if isOwner(userId);
      
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      // Subcoleção de Desempenho (users/{userId}/attempts/{attemptId})
      match /attempts/{attemptId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Ranking do Simulado Oficial da Semana (Leaderboard público)
    match /rankings/{rankingId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == rankingId
        && request.resource.data.percentage is number;

      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
